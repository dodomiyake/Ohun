# Ohun V2 — local development placeholders only.
# Copy to apps/api/.env and apps/web/.env as needed.
# Do not put real secrets, production URLs, or credentials here.

# --- API (apps/api) ---
NODE_ENV=development
PORT=5000
# Required for M2 API runtime. Tests may inject an isolated replica-set URI.
MONGO_URI=
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=
JWT_ISSUER=ohun-api
JWT_AUDIENCE=ohun-clients
TOKEN_HMAC_MASTER=
COOKIE_SECURE=false
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_NATIVE_ABSOLUTE_SECONDS=2592000
SESSION_NATIVE_IDLE_SECONDS=604800
EMAIL_VERIFICATION_LINK_TTL_SECONDS=86400
EMAIL_VERIFICATION_CODE_TTL_SECONDS=600
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_LOCK_SECONDS=1800
PASSWORD_RESET_TTL_SECONDS=3600
SESSION_LAST_USED_THROTTLE_SECONDS=300
EMAIL_PROVIDER=memory
AVATAR_STORAGE_PROVIDER=memory
PASSWORD_BLOCKLIST_PROVIDER=memory

# --- Web (apps/web) ---
VITE_API_BASE_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# --- Mobile (apps/mobile) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# Local terminal inbox; disabled unless explicitly enabled in development.
DEV_INBOX_ENABLED=false
DEV_INBOX_SECRET=
