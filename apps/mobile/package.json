{
  "name": "@ohun/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate": "expo config --type public",
    "build": "npm run typecheck && npm run validate"
  },
  "dependencies": {
    "@ohun/contracts": "*",
    "@ohun/design-tokens": "*",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@tanstack/react-query": "^5.67.2",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.9",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@ohun/config": "*",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  }
